rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Platform admin (you) — must match assets/js/payment-config.js
    // ADMIN_UIDS exactly, or the in-dashboard "Pending Payments" approve
    // panel (admin-payments.html) won't be able to write anything.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'I50u3zwtzAWyeNYFJpvRTTE5Mtl1'
      ];
    }

    // Each signed-in user can read their own profile doc, created at
    // assets/js/auth-forms.js on registration.
    //
    // IMPORTANT: `plan` (and the initial `trialStartedAt`) are billing-
    // critical fields. New accounts must start on plan:"trial", and after
    // that, the ONLY way `plan` may change is the paymentCallback Cloud
    // Function (functions/index.js) using the Admin SDK, which bypasses
    // these rules entirely after independently verifying payment with
    // SSLCommerz. Ordinary profile edits (name, business name, etc.) are
    // still allowed from the client; a narrow one-time exception lets
    // legacy accounts that predate the trial-lock feature self-heal a
    // missing trialStartedAt without touching `plan`.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.plan == 'trial';

      allow update: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'businessName', 'businessType', 'branchCount', 'city', 'displayName', 'email'])
        ||
        ( !('trialStartedAt' in resource.data)
          && request.resource.data.plan == 'trial'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['trialStartedAt', 'plan']) )
      )
      // The ONLY other way `plan` may change from the client: the admin
      // approving a manual bKash/Nagad order in admin-payments.html. This
      // also stamps planExpiresAt (start + the order's billing cycle), so
      // the plan auto-locks again when it lapses without another approval.
      || ( isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['plan', 'planUpdatedAt', 'planExpiresAt']) );

      allow delete: if false;
    }

    // Orders: manual bKash/Nagad payment proof submitted by the customer at
    // registration (see assets/js/register-wizard.js). The customer can only
    // ever CREATE their own order in "pending_verification" status — they
    // can never set it to paid/approved themselves. Only the admin
    // (admin-payments.html) can flip the status after checking the TrxID/
    // sender number, and only the status/review fields — never the amount,
    // plan, or proof the customer submitted.
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.plan in ['starter', 'pro']
        && request.resource.data.keys().hasAll(
             ['uid', 'plan', 'billingCycle', 'amount', 'method', 'senderNumber', 'trxId', 'status', 'createdAt']);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectReason']);

      allow delete: if false;
    }

    // Anyone (even signed-out visitors) can submit the public contact form,
    // but only signed-in users (the business owner/staff) can read, edit,
    // or delete messages — matches assets/js/contact-firestore.js +
    // assets/js/dashboard.js.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Inventory: any signed-in staff member can view and manage products.
    // (Single-business setup — every signed-in user is treated as staff.
    // If you later support multiple businesses, scope these by a
    // businessId field instead.)
    match /products/{productId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Sales: created by the POS screen at checkout. Signed-in staff can
    // read the sales log; edits/deletes are allowed for corrections but
    // could be locked down further (e.g. to admins only) later.
    match /sales/{saleId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Accounting: manually logged expenses.
    match /expenses/{expenseId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Customers: contact info + running "due" (credit) balance.
    match /customers/{customerId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // HR: staff records.
    match /employees/{employeeId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Payroll: monthly salary payment log (also mirrored into /expenses
    // when marked paid — see assets/js/hr-payroll.js).
    match /payrollRecords/{recordId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Settings: single shared business-profile doc (id "business") plus
    // room for future per-feature settings docs.
    match /settings/{settingsId} {
      allow read, create, update, delete: if request.auth != null;
    }
  }
}
