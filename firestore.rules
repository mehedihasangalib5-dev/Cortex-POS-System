rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Platform admin (you) — must match assets/js/payment-config.js
    // ADMIN_UIDS exactly, or the in-dashboard "Pending Payments" approve
    // panel (admin-payments.html) won't be able to write anything.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        '6q238xgdsBSf8Q0ZnPwLbqswrxR2'
      ];
    }

    // --- Multi-tenancy -------------------------------------------------
    // Every signed-in user belongs to exactly one "business", identified
    // by businessId — a plain string equal to the OWNER's uid (an owner's
    // own businessId is their own uid; an invited staff member's
    // businessId is the owner's uid — see assets/js/business-context.js
    // and register-wizard.js). These two helpers do one extra document
    // read each (Firestore caches get() within a single request, so this
    // doesn't multiply per document in a list query).
    function myBusinessId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // NOTE: reading a map key that doesn't exist (dot access) THROWS in
    // Firestore rules instead of returning null the way JS would. Legacy
    // user docs predate the `roleId` field entirely, so this must use the
    // `in` operator to check the field exists before reading it — otherwise
    // every legacy staff account throws here (and is therefore DENIED
    // below) instead of getting the intended fail-open behavior.
    function myRoleId() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('roleId' in u) ? u.roleId : null;
    }
    // Whether the signed-in user is allowed to delete records (products,
    // customers). The owner always can. A staff member can unless their
    // assigned custom role explicitly turns "deleteRecords" off — no
    // roleId (legacy accounts), a since-deleted role doc, or a role doc
    // missing the permissions map/key all fail OPEN, matching
    // resolvePermissions()'s fail-open default in assets/js/roles-utils.js,
    // so a hiccup here never locks a business out of its own data.
    function canDeleteRecords() {
      return myRole() == 'owner'
        || myRoleId() == null
        || !exists(/databases/$(database)/documents/roles/$(myRoleId()))
        || !('permissions' in get(/databases/$(database)/documents/roles/$(myRoleId())).data)
        || !('deleteRecords' in get(/databases/$(database)/documents/roles/$(myRoleId())).data.permissions)
        || get(/databases/$(database)/documents/roles/$(myRoleId())).data.permissions.deleteRecords != false;
    }

    // Each signed-in user can read their own profile doc, created at
    // assets/js/register-wizard.js on registration — plus, so the Team
    // section in settings.html can list co-workers, anyone can read a
    // profile doc that shares their own businessId.
    //
    // IMPORTANT: `plan`, `planExpiresAt`, `businessId`, and `role` are
    // billing/tenancy-critical fields. They can only change via:
    //   - account creation (owner: businessId = own uid, role "owner",
    //     plan "trial"; staff: businessId + role come from a validated
    //     pending invite)
    //   - the admin approving a manual bKash/Nagad order
    //     (admin-payments.html), which also stamps planExpiresAt
    //   - a narrow one-time self-heal for legacy accounts/documents that
    //     predate a field being introduced (trialStartedAt, businessId)
    // Ordinary profile edits (name, phone, etc.) are always allowed from
    // the client for the user's own doc.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
        || resource.data.businessId == myBusinessId()
      );

      // New business owner.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'owner'
                    && request.resource.data.businessId == userId
                    && request.resource.data.plan == 'trial';

      // New staff member joining via a pending invite addressed to their
      // own (verified) sign-in email. inviteId must be included on the
      // new doc so this rule can look the invite up directly.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'staff'
                    && 'inviteId' in request.resource.data
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.status == 'pending'
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email
                    && request.resource.data.businessId == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.businessId;

      allow update: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'businessName', 'businessType', 'branchCount', 'city', 'displayName', 'email', 'phone'])
        ||
        // Legacy self-heal: account predates the trial-lock feature.
        ( !('trialStartedAt' in resource.data)
          && request.resource.data.plan == 'trial'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['trialStartedAt', 'plan']) )
        ||
        // Legacy self-heal: account predates multi-tenancy — becomes the
        // owner of its own (new) business, matching how it already
        // behaved (see assets/js/business-context.js).
        ( !('businessId' in resource.data)
          && request.resource.data.businessId == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['businessId', 'role']) )
      )
      // A teammate's business may itself be a legacy business missing its
      // trialStartedAt stamp — allow any member of that same business to
      // trigger that specific, narrow self-heal on the owner's doc too.
      || ( request.auth != null
           && resource.data.businessId == myBusinessId()
           && !('trialStartedAt' in resource.data)
           && request.resource.data.plan == 'trial'
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['trialStartedAt', 'plan']) )
      // The owner reassigning a staff member's custom role (Settings >
      // Team). Only the roleId field — never businessId/role/plan.
      || ( request.auth != null && myRole() == 'owner'
           && resource.data.businessId == myBusinessId()
           && resource.data.role == 'staff'
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleId']) )
      // The admin approving a manual bKash/Nagad order
      // (admin-payments.html). Also stamps planExpiresAt (start + the
      // order's billing cycle), so the plan auto-locks again when it
      // lapses without another approval.
      || ( isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['plan', 'planUpdatedAt', 'planExpiresAt']) );

      // The owner can remove a staff member (Team section in
      // settings.html). The removed account keeps its Firebase Auth
      // login but has no business doc anymore, so app-shell.js's guard
      // treats their next sign-in as a fresh, unaffiliated account.
      allow delete: if request.auth != null
        && myRole() == 'owner'
        && resource.data.businessId == myBusinessId()
        && resource.data.role == 'staff';
    }

    // Team invites — an owner invites a teammate by email (settings.html);
    // the teammate's account is created with that role/businessId once
    // they sign up with the matching email (see the users/{userId} create
    // rule above and register-wizard.js).
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        request.auth.token.email == resource.data.email
        || resource.data.businessId == myBusinessId()
      );

      allow create: if request.auth != null
        && myRole() == 'owner'
        && request.resource.data.businessId == myBusinessId()
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'staff';

      // The invitee accepting it (register-wizard.js) — only the
      // status/acceptance fields, never who it's for or which business.
      allow update: if request.auth != null
        && request.auth.token.email == resource.data.email
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'acceptedBy', 'acceptedAt']);

      // The owner cancelling a pending invite.
      allow delete: if request.auth != null
        && myRole() == 'owner'
        && resource.data.businessId == myBusinessId();
    }

    // Orders: manual bKash/Nagad payment proof, submitted either at
    // registration (new business, see register-wizard.js) or from an
    // existing owner upgrading/renewing a plan (settings.html). Always
    // filed under `uid` == the business's businessId (== the owner's
    // uid), whichever of the two flows created it. The customer can only
    // ever CREATE their own order in "pending_verification" status —
    // they can never set it to approved themselves. Only the admin
    // (admin-payments.html) can flip the status after checking the
    // TrxID/sender number, and only the status/review fields — never the
    // amount, plan, or proof submitted.
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.plan in ['starter', 'pro']
        && request.resource.data.keys().hasAll(
             ['uid', 'plan', 'billingCycle', 'amount', 'method', 'senderNumber', 'trxId', 'status', 'createdAt']);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectReason']);

      allow delete: if false;
    }

    // Anyone (even signed-out visitors) can submit the public contact
    // form. It's a submission to the PLATFORM's own "Contact Us" page
    // (index.html/contact.html) — not per-business tenant data — so only
    // the platform admin can read/manage the inbox, never a tenant.
    // Full inbox management (mark read/replied, delete) lives in its own
    // admin panel — see admin-messages.html.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- Per-business data --------------------------------------------
    // Every document here is scoped by a businessId field. A signed-in
    // user (owner or invited staff) can only read/write documents whose
    // businessId matches their own — see myBusinessId() above.

    match /roles/{roleId} {
      allow read: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && myRole() == 'owner'
        && request.resource.data.businessId == myBusinessId();
      // Owner can rename/edit a role's permissions any time, but can't
      // repurpose the businessId or the isSystem flag (Owner/Staff must
      // stay recognizable as the two built-in roles).
      allow update: if request.auth != null && myRole() == 'owner'
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId()
        && request.resource.data.isSystem == resource.data.isSystem;
      // System roles (Owner/Staff) can never be deleted — only custom
      // roles the owner created.
      allow delete: if request.auth != null && myRole() == 'owner'
        && resource.data.businessId == myBusinessId()
        && resource.data.isSystem != true;
    }

    match /warehouses/{warehouseId} {
      allow read, delete: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    match /stockTransfers/{transferId} {
      allow read, delete: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    match /products/{productId} {
      allow read: if request.auth != null && resource.data.businessId == myBusinessId();
      allow delete: if request.auth != null && resource.data.businessId == myBusinessId() && canDeleteRecords();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    match /sales/{saleId} {
      allow read, delete: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    match /expenses/{expenseId} {
      allow read, delete: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    match /customers/{customerId} {
      allow read: if request.auth != null && resource.data.businessId == myBusinessId();
      allow delete: if request.auth != null && resource.data.businessId == myBusinessId() && canDeleteRecords();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    match /employees/{employeeId} {
      allow read, delete: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    match /payrollRecords/{recordId} {
      allow read, delete: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
        && resource.data.businessId == myBusinessId()
        && request.resource.data.businessId == myBusinessId();
    }

    // Business-profile doc — one per business, doc ID == businessId
    // directly (no separate field/query needed).
    match /settings/{settingsId} {
      allow read, create, update, delete: if request.auth != null && settingsId == myBusinessId();
    }
  }
}
