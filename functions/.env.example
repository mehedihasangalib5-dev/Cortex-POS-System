# Copy this file to functions/.env and fill in real values before deploying.
# NEVER commit the real functions/.env file — it holds your SSLCommerz secret.

# From your SSLCommerz merchant panel (sandbox: https://developer.sslcommerz.com/registration/)
SSLCZ_STORE_ID=your_store_id
SSLCZ_STORE_PASSWORD=your_store_password

# "sandbox" while testing, "live" once you have a real (non-sandbox) SSLCommerz account
SSLCZ_MODE=sandbox

# The public URL of your landing site (wherever pricing.html / settings.html
# are actually hosted — cPanel, VPS, Firebase Hosting, etc.). No trailing slash.
SITE_URL=https://your-domain.com

# Optional but recommended: the base URL Cloud Functions are deployed at,
# e.g. https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net
# If you skip this, index.js guesses it from GCLOUD_PROJECT, which is not
# always reliable for 2nd-gen functions — safer to set it explicitly after
# your first deploy (the deploy output prints the real function URLs).
FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net
